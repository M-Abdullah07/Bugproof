# Copy to .env. Keep .env private; never commit real credentials.
BUGPROOF_DEMO_PASSWORD=
BUGPROOF_SESSION_SECRET=
BUGPROOF_DATABASE_PATH=.data/bugproof.sqlite3
BUGPROOF_BUILD_REF=development
BUGPROOF_ENV=local
BUGPROOF_LAB_SECRET=
BUGPROOF_MAILBOX=
BUGPROOF_REPOSITORY=M-Abdullah07/Bugproof
BUGPROOF_FASTN_OAUTH_PATH=.data/fastn-oauth.json
# Hosting bootstrap only: private JSON from the OAuth setup, never commit tokens.
BUGPROOF_FASTN_OAUTH_JSON=
PORT=8000

# Empty values do not simulate integrations.
GEMINI_API_KEY=
# Select an available Gemini structured-output model after capability verification.
BUGPROOF_MODEL=
FASTN_API_KEY=
FASTN_MCP_URL=https://mcp.fastn.dev
FASTN_PROJECT_ID=
# Context only: an organization slug is not interchangeable with project ID.
FASTN_ORGANIZATION_SLUG=
# Runtime uses OAuth for mcp.fastn.dev; FASTN_API_KEY is legacy preflight only.
