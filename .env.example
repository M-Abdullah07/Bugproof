# Copy to .env. Keep .env private; never commit real credentials.
BUGPROOF_DEMO_PASSWORD=
BUGPROOF_SESSION_SECRET=
BUGPROOF_DATABASE_PATH=.data/bugproof.sqlite3
BUGPROOF_BUILD_REF=development
BUGPROOF_ENV=local
PORT=8000

# Account setup is still required; empty values do not simulate integrations.
GROQ_API_KEY=
BUGPROOF_MODEL=openai/gpt-oss-120b
FASTN_API_KEY=
FASTN_PROJECT_ID=
# Remaining connection/tool IDs follow verified tool discovery.
